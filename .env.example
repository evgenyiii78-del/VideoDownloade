BOT_TOKEN=1234567890:replace_with_your_bot_token
DOWNLOAD_DIR=downloads
MAX_UPLOAD_MB=49
MAX_CONCURRENT_DOWNLOADS=3

# Instagram authorization (recommended if public Reels fail).
# Copy these cookie VALUES from your own logged-in Instagram browser session.
# Keep them only in .env on the server. Never commit real values to GitHub.
# INSTAGRAM_SESSIONID=
# INSTAGRAM_CSRFTOKEN=
# INSTAGRAM_DS_USER_ID=

# Alternative: Netscape-format cookies file.
# COOKIES_FILE=/app/secrets/cookies.txt

# Optional. Normally not needed in Docker because ffmpeg is installed system-wide.
# FFMPEG_LOCATION=/usr/bin
